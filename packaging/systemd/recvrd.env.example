# Optional environment for recvrd.service.
# Copy this file to ~/.config/recvrd/env and uncomment what you need.

# HTTP bind address/port (defaults: 127.0.0.1 and 8080).
# RECVRD_BIND=127.0.0.1
# RECVRD_PORT=8080

# Explicit headers file. By default the daemon uses
# ~/.config/recvrd/headers.txt with a legacy fallback.
# RECVRD_HEADERS=/home/your-user/.config/recvrd/headers.txt

# Optional explicit config file.
# RECVRD_CONFIG=/home/your-user/.config/recvrd/config.toml

# Optional Podverse API. The provider is hidden when the URL is absent.
# RECVRD_PODVERSE_URL=https://podverse.example.com/api/v2
# RECVRD_PODVERSE_TOKEN=optional-bearer-token

# Log level (error, warn, info, debug, trace).
# RUST_LOG=info
