# Daemon environment. Copy this file to recvrd.env.
# Compose loads this file when it exists.
# Leave a value commented to disable that option.
# Do not commit recvrd.env. It can hold secrets.

# Podverse API. The provider stays hidden without a URL.
# RECVRD_PODVERSE_URL=https://podverse.example.com/api/v2
# RECVRD_PODVERSE_TOKEN=

# Podverse position sync. The daemon syncs positions when true.
# RECVRD_PODVERSE_SYNC=false

# Last.fm scrobbling. The daemon scrobbles when enabled.
# RECVRD_LASTFM_ENABLED=false
# RECVRD_LASTFM_API_KEY=
# RECVRD_LASTFM_API_SECRET=
# RECVRD_LASTFM_SESSION_KEY=

# ListenBrainz scrobbling. The daemon scrobbles when enabled.
# RECVRD_LISTENBRAINZ_ENABLED=false
# RECVRD_LISTENBRAINZ_TOKEN=
