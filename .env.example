# Compose variables. Copy this file to .env.
# These variables configure Compose, not the daemon.
# The daemon reads secrets from recvrd.env instead.
# Set UID and GID to your host user and group.
# Rebuild the image after you change them.
UID=1000
GID=1000
# Port on the host. Compose publishes it on loopback only.
RECVRD_PORT=8080
# Log level: error, warn, info, debug, trace.
RUST_LOG=info
# Host path to your local music library.
MUSIC_DIR=./music
# yt-dlp release to install. Update the value and rebuild when downloads fail.
# YT_DLP_VERSION=2026.11.23
# Host port for the dev daemon API. The Vite dev server uses 5173.
# RECVRD_DEV_API_PORT=18080
# Optional. Set the host runtime directory for the PipeWire and D-Bus mounts.
# XDG_RUNTIME_DIR=/run/user/1000
